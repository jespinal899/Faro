# ===== Secretos (NUNCA subir) =====
.env
.env.*
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/

# ===== Node / Frontend =====
node_modules/
dist/
# Resultados de Playwright (trazas y capturas de fallos)
test-results/
playwright-report/
build/

# ===== Datos y artefactos pesados =====
# Respaldos y volcados de bases de datos (se obtienen con los scripts, no se versionan)
*.bak
*.bacpac
*.dump
data/raw/
# Artefactos de MLflow / modelos entrenados (se regeneran con el pipeline)
mlruns/
mlartifacts/
machine_learning/models/*
!machine_learning/models/.gitkeep

# ===== Herramientas de agentes / Neon =====
# Vínculo local con el proyecto de Neon (IDs de org/proyecto/rama de cada desarrollador)
.neon
# Preferencias personales de Claude Code (las compartidas van en .claude/settings.json)
.claude/settings.local.json
# Vínculo local con el proyecto de Vercel (lo crea "vercel link"; sus variables van en .env.local)
.vercel

# ===== Logs =====
*.log
logs/

# ===== Sistema operativo / IDE =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
