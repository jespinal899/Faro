# ===== Secretos (NUNCA subir) =====
.env
.env.*
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/

# ===== Node / Frontend =====
node_modules/
dist/
