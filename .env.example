# Copia este archivo como ".env" y reemplaza los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# ============================================================
# PostgreSQL local (Docker) — entorno de DESARROLLO
# ============================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5433

# Cadenas de conexión que usará Python (desarrollo local)
SOURCE_DATABASE_URL=postgresql://admin:cambia_esta_clave@localhost:5433/wwi_oltp
ANALYTICS_DATABASE_URL=postgresql://admin:cambia_esta_clave@localhost:5433/faro_analytics

# ============================================================
# Neon — entorno de PRODUCCIÓN
# Proyectos: wwi-oltp (base wwi_oltp) y faro-analytics (base faro_analytics).
# Usar conexiones DIRECTAS (host SIN "-pooler") para migraciones, cargas y ETL.
# Obtenerlas sin copiarlas a mano (requiere `neon login`):
#   neon connection-string production --project-id <id> --database-name wwi_oltp --role-name wwi_oltp_owner
# En GitHub Actions viven como secrets del environment "production".
# ============================================================
NEON_SOURCE_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/wwi_oltp?sslmode=require&channel_binding=require
NEON_ANALYTICS_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-yyyy.REGION.aws.neon.tech/faro_analytics?sslmode=require&channel_binding=require

# Roles de mínimo privilegio (los genera database/scripts/configurar_roles.py --entorno neon)
# NEON_ETL_SOURCE_URL=...     etl_lector: el ETL lee la fuente
# NEON_APP_SOURCE_URL=...     wwi_app: el simulador inserta ventas
# NEON_ETL_ANALYTICS_URL=...  faro_etl: el ETL escribe staging y auditoría

# ============================================================
# SOLO Fase 1 (temporal): SQL Server desechable para leer el
# respaldo de WideWorldImporters. Mínimo 8 caracteres con
# mayúsculas, minúsculas y números.
# ============================================================
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_123
SEED_MSSQL_HOST=localhost
SEED_MSSQL_PORT=14330
