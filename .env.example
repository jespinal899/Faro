# Copia este archivo como ".env" y reemplaza los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# ============================================================
# PostgreSQL local (Docker) — entorno de DESARROLLO
# ============================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5433

# Cadenas de conexión que usará Python (desarrollo local)
SOURCE_DATABASE_URL=postgresql://admin:cambia_esta_clave@localhost:5433/wwi_oltp
ANALYTICS_DATABASE_URL=postgresql://admin:cambia_esta_clave@localhost:5433/faro_analytics

# ============================================================
# Neon — entorno de PRODUCCIÓN (se completa al desplegar)
# Neon exige SSL: siempre terminar con ?sslmode=require
# ============================================================
# SOURCE_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/wwi_oltp?sslmode=require
# ANALYTICS_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-yyyy.REGION.aws.neon.tech/faro_analytics?sslmode=require
